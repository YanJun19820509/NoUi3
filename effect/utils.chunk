// 安全取小数部分（处理负数情况）
// 示例: ffract(-1.5) -> 0.5, ffract(2.3) -> 0.3
float ffract(float a){
  return fract(a + 1.);
}

// 安全取整（避免浮点精度问题）
// 示例: ffloor(2.9999999) -> 2.0, ffloor(3.0000001) -> 3.0
float ffloor(float a){
  return floor(a+ 0.00000001);
}

/**
 * 数值解析工具函数
 * @param defines 原始数值
 * @param isFloor 解析模式：true-整数模式（从高位开始） / false-小数模式（从小数点后开始）
 * @param start 起始位数（0开始）
 * @param n 要取的位数
 * @return 解析出的数值
 * 示例（整数模式）: defineVal(12345, true, 1, 2) -> 34（从第1位开始取2位）
 * 示例（小数模式）: defineVal(0.12345, false, 1, 2) -> 23（取小数点后第1位开始的2位）
 */
float defineVal(float defines,const bool isFloor,const float start,const float n){
  if (isFloor){
    float a = defines/pow(10.,start + n); // 右移去掉低位数字
    a = ffract(a)*pow(10.,n); // 取小数部分并左移恢复有效位
    return ffloor(a);
  }else{
    float a = defines*pow(10.,start); // 左移去掉整数部分
    a = ffract(a)*pow(10.,n); // 取小数部分并左移有效位
    return ffloor(a);
  }
}

/**
 * 检查定义值的特定位是否等于目标值
 * @param start 检测起始位（0开始）
 * 示例: isTrue(1234, true, 2, 1) -> 检查第1位是否等于2（数值3）
 */
bool isTrue(float defines, bool isFloor, float checkValue, float start){
  return defineVal(defines, isFloor, start, 1.) == checkValue;
}

/**
 * 检查定义值的特定位是否有设置类型
 * @param start 检测起始位（0开始）
 * 示例: hasDefineType(1005, true, 3) -> 检查千位是否>0（数值1）
 */
bool hasDefineType(float defines, bool isFloor, float start){
  return defineVal(defines, isFloor, start, 1.) > 0.;
}

/**
 * 从压缩数据解析颜色值（RGB分量各占0-999，存储为vec3的x/y分量）
 * @param ext 压缩后的颜色数据（x存R+G，y存B+A）
 * 示例: ext=vec3(1234.5, 567.8, 0.5) -> 
 *       r=1234.5/1000=1.234取整=1 -> r=1/255
 *       g=1234.5-1*1000=234.5 -> g=234.5/255
 *       b=567.8/1000=0.567取整=0 -> b=0/255
 *       最终颜色vec4(1/255, 234.5/255, 0/255, 0.5)
 */
vec4 getColorFromExt(vec3 ext){
  float r = ffloor(ext.x / 1000.0);      // 提取红色分量
  float g = ext.x - r * 1000.0;          // 提取绿色分量
  float b = ffloor(ext.y / 1000.0);      // 提取蓝色分量
  color = vec4(r/255.0,g/255.0,b/255.0,ext.z); // 组合为标准化颜色值
}

/**
 * 基于噪声的伪随机数生成器
 * @param st 输入种子坐标
 * 示例: rand(vec2(1.0,2.0)) -> 0.734
 *       原理: 通过正弦函数和超大系数制造随机分布
 */
float rand(vec2 st){
  return ffract(sin(dot(st,vec2(12.9898,78.233)))*43758.5453123);
}


/**
 * 计算颜色亮度值（心理学灰度公式）
 * @param _color 输入颜色
 * @returns 灰度值（范围0-1）
 * @example grayF(vec4(1.0,0.0,0.0,1.0)) -> 0.299（红色通道的亮度贡献）
 */
float grayF(vec4 _color){
  return dot(_color.rgb, vec3(0.299,0.587,0.114)); // RGB亮度权重系数
}

/**
 * 颜色置灰处理
 * @param _o 原始颜色
 * @returns 灰度颜色（保持alpha通道不变）
 * @example gray(vec4(0.2,0.8,0.5,1.0)) -> vec4(0.6016,0.6016,0.6016,1.0)
 */
vec4 gray(vec4 _o){
  float gray  = grayF(_o); // 获取亮度值
  _o.r = _o.g = _o.b = gray; // 三通道统一为灰度值
  return _o;
}

/**
 * 颜色混合算法
 * @param _c1 基础颜色
 * @param _c2 混合颜色
 * @param _type 混合模式（1-6）:
 * 1=相加 2=相减 3=相乘 4=黄金比例插值 5=加权混合 6=基于亮度的混合
 * @returns 混合后的颜色
 * @example 
 * blend(vec4(1,0,0,1), vec4(0,1,0,1), 1.0) -> vec4(1,1,0,1) // 加法混合
 * blend(vec4(0.5), vec4(0.5), 4.0) -> vec4(0.5) // 黄金比例插值
 */
vec4 blend(vec4 _c1, vec4 _c2, float _type){
  if (_type == 1.) _c1 += _c2; // 加法混合（颜色变亮）
  else if (_type == 2.) _c1 -= _c2; // 减法混合（颜色变暗）
  else if (_type == 3.) _c1 *= _c2; // 正片叠底（暗部增强）
  else if (_type == 4.) _c1.rgb = mix(_c1.rgb, _c2.rgb, .618); // 黄金比例插值
  else if (_type == 5.) _c1.rgb = _c1.rgb * .2 + _c2.rgb * 1.2; // 加权混合（突出_c2）
  else if (_type == 6.) _c1.rgb = mix(_c1.rgb, _c2.rgb*1.5, grayF(_c2)); // 基于_c2亮度的混合
  return _c1;
}

/**
 * 动态彩虹色板生成器
 * @param t 基础时间参数（范围0-1）
 * @returns RGB颜色值
 * @example 
 * Pallete(0.0) -> 随时间变化的彩虹色起始颜色
 * Pallete(0.5) -> 彩虹色中间过渡颜色
 */
vec3 Pallete(float t) {
  t += cc_time.x; // 随时间自动滚动
  vec3 dcOffset = vec3(0.5); // 颜色基准偏移
  vec3 amp = vec3(1.);      // 振幅系数
  vec3 freq = vec3(1.);     // 频率系数
  vec3 phase = vec3(0., 0.3333, 0.6666); // RGB相位差（120度间隔）
  return dcOffset + amp * cos(2. * 3.14159 * (freq * t + phase)); // 余弦函数生成三通道色值
}

/**
 * 斜向扫光效果
 * @param _o 原始颜色
 * @param _uv 纹理坐标
 * @param _start 起始位置偏移
 * @param _width 光带宽度
 * @param _strength 光强系数
 * @param _reverse 反向模式（true时仅保留光带区域）
 * @returns 处理后的颜色
 * @example 
 * shine(color,uv,0.5,0.2,2.0,false) -> 中等强度扫光效果
 * shine(color,uv,0.0,0.1,3.0,true) -> 窄光带+反向模式（手电筒效果）
 */
vec4 shine(vec4 _o, vec2 _uv, float _start, float _width, float _strength, bool _reverse){
  // 定义斜线区域：_uv.x + _uv.y ∈ [_start - _width, _start]
  if (_uv.x <= -_uv.y + _start && _uv.x >= -_uv.y - _width + _start){
    _o *= _strength;  // 增强光带区域亮度
  }
  else if( _reverse ) {  
    discard; // 反向模式时丢弃非光带区域像素
  }
  return _o;
}


/**
 * 圆形头像裁剪效果带羽化
 * @param _o 原始颜色值
 * @param _uv 当前像素坐标（归一化0-1）
 * @param _center 圆心坐标（通常为vec2(0.5,0.5)）
 * @param _radius 圆半径（0-1范围）
 * @param _feather 羽化范围（0-0.2效果较好）
 * @returns 裁剪后的颜色值
 * @example 
 * mask(color,uv,vec2(0.5),0.45,0.05) // 标准圆形头像，带5%边缘羽化
 * mask(color,uv,vec2(0.3,0.7),0.2,0.1) // 偏心圆形裁剪，较大羽化范围
 */
vec4 mask(vec4 _o, vec2 _uv, vec2 _center, float _radius, float _feather){
    // 计算当前像素到圆心的归一化距离
    float dis = distance(_uv, _center);

    // 硬裁剪：直接丢弃圆外像素
    if( dis > _radius ){
        discard;
    }

    // 羽化处理：在半径边缘附近创建平滑过渡
    if( _feather > 0.0 ){
      // 使用smoothstep创建平滑过渡曲线，参数说明：
      // edge0: 完全透明边界（_radius - _feather）
      // edge1: 完全不透明边界（_radius）
      _o.a *= smoothstep(_radius, _radius - _feather, dis);
    }
  return _o;
}

/**
 * 圆角矩形区域裁剪（无颜色返回，直接丢弃区域外像素）
 * @param _uv 当前像素坐标
 * @param _center 矩形中心坐标
 * @param _radius 圆角半径
 * @param _base 矩形基础尺寸（width/height的一半）
 * @example 
 * roundedRectangle(uv,vec2(0.5),0.1,0.4) // 创建尺寸0.8x0.8，圆角半径0.1的矩形
 */
void roundedRectangle(vec2 _uv, vec2 _center, float _radius, float _base){
  // 坐标变换：将坐标系移至中心，并取绝对值得到第一象限坐标
  vec2 uv = _uv - _center;
  uv.x = abs(uv.x);
  uv.y = abs(uv.y);

  // 计算直角区域边界（减去圆角半径后的矩形区域）
  float r = _base - _radius;
  
  // 仅处理四个圆角区域的像素
  if (uv.x > r && uv.y > r) {
    // 坐标平移至圆角圆心坐标系
    uv.x -= r;
    uv.y -= r;

    // 圆角裁剪：距离超过圆角半径则丢弃
    float dis = distance(uv, vec2(0,0));
    if( dis >= _radius ) {
      discard;
    }
  }
}

/**
 * 圆孔裁剪效果（反向遮罩）带羽化
 * @param _o 原始颜色值
 * @param _uv 当前像素坐标
 * @param _center 圆心坐标
 * @param _radius 圆孔半径
 * @param _feather 羽化范围
 * @returns 裁剪后的颜色值
 * @example 
 * hole(color,uv,vec2(0.5),0.3,0.05) // 中心圆孔，锐利边缘
 * hole(color,uv,vec2(0.2,0.8),0.15,0.1) // 偏心圆孔，宽羽化效果
 */
vec4 hole(vec4 _o, vec2 _uv, vec2 _center, float _radius, float _feather){
    float dis = distance(_uv, _center);

    // 反向裁剪：丢弃圆内像素
    if( dis < _radius ){
        discard;
    }

    // 外边缘羽化处理（与mask方向相反）
    if( _feather > 0.0 ){
      // 羽化区间从_radius到_radius+_feather
      _o.a *= smoothstep( _radius, _radius + _feather, dis);
    }
  return _o;
}



/**
 * 渐变消失效果
 * @param _o 原始颜色值
 * @param _uv 纹理坐标 (0.0-1.0)
 * @param _time 消失进度 (0.0-1.0) 控制渐变起始位置
 * @param _width 渐变过渡区域宽度 (0.0-1.0)
 * @param _vertical 是否垂直方向渐变（true=垂直从上到下，false=水平从左到右）
 * @returns 处理后的颜色值
 * @example 
 * fadeOut(color, uv, 0.5, 0.2, true) // 垂直方向50%位置开始，0.2宽度的渐变消失
 * fadeOut(color, uv, 0.8, 0.1, false) // 水平方向80%位置开始，0.1宽度的渐变消失
 */
vec4 fadeOut(vec4 _o,vec2 _uv,  float _time, float _width, bool _vertical){
  // 基础透明度过滤，保留半透明以上区域进行处理
  if (_o.a > 0.3){
    if(_vertical) {
        // 垂直方向渐变：基于y坐标的smoothstep插值
        // _time - _width 到 _time 区间内产生平滑过渡
        _o.a *= smoothstep(_time - _width, _time, _uv.y);
    } else {
        // 水平方向渐变：基于x坐标的smoothstep插值
        _o.a *= smoothstep(_time - _width, _time, _uv.x);
    }
  } else _o.a = 0.0; // 完全透明区域直接置零
  return _o;
}

/**
 * 高斯模糊纹理效果
 * @param _o 原始颜色值
 * @param _uv 纹理坐标
 * @param _offset 模糊强度（采样偏移量，建议0.001-0.01）
 * @returns 模糊处理后的颜色值
 * @example 
 * blurTexture(color, uv, 0.005) // 中等强度模糊
 * blurTexture(color, uv, 0.01)  // 高强度模糊
 */
vec4 blurTexture(vec4 _o, vec2 _uv, vec2 _offset){
  // 采用10个方向采样实现近似高斯模糊
  const int repeats = 10;
  
  vec2 q[10];
  q[0] = vec2(1.,0.);
  q[1] = vec2(0.8092,0.5875);
  q[2] = vec2(0.3096,0.9508);
  q[3] = vec2(-0.3081,0.9513);
  q[4] = vec2(-0.8082,0.5888);
  q[5] = vec2(-1.,0.0015);
  q[6] = vec2(-0.8101,-0.5862);
  q[7] = vec2(-0.3111,-0.9503);
  q[8] = vec2(0.3065,-0.9518);
  q[9] = vec2(0.8073,-0.5901);
  // 多方向采样混合
  for(int i=0; i<repeats ; i++) {
      // 添加随机偏移避免规则采样带来的图案重复感
      vec2 uv2 = _uv + q[i] * rand(vec2(i, _uv.x + _uv.y )) * _offset;
      
      // 累加周边采样颜色
      _o += normalTexture(cc_spriteTexture, uv2);
  }

  // 平均采样结果（简单盒式模糊）
  _o /= float(repeats);

  // 后处理：降低亮度并二值化透明度
  float light = 0.7; // 亮度衰减系数
  _o *= light;
  _o.a = step(0.4, _o.a); // 透明度二值化（alpha>=0.4为1，否则为0）

  return _o;
}

/**
 * 溶解效果
 * @param _o 原始颜色值
 * @param _time 溶解阈值 (0.0-1.0) 控制溶解进度
 * @returns 处理后的颜色值（部分像素被丢弃）
 * @example 
 * dissolve(color, 0.5) // 溶解50%的像素
 * dissolve(color, 0.8) // 溶解80%的像素
 * @note 实际使用建议配合噪声贴图实现更自然的溶解效果
 */
void dissolve(vec4 _o, float _time) {
  // 计算颜色亮度作为溶解依据
  float h = (_o.g + _o.r + _o.b)/3.0;
  
  // 动态阈值溶解
  if(h < _time) {
    discard; // 完全丢弃低于阈值的像素
  }
}



/**
 * 描边检测函数
 * @param _texture 源纹理
 * @param _uv 当前纹理坐标
 * @param _outlineWidth 描边宽度（建议范围0.0-0.1）
 * @return 描边强度（0.0-12.0，表示12个采样方向中满足条件的数量）
 * @example
 * // 在片段着色器中使用：
 * float stroke = isStroke(cc_spriteTexture, uv, 0.02);
 * if(stroke > 0.0) { // 存在描边区域
 *     gl_FragColor = vec4(1.0,0,0,1); // 显示红色描边
 * }
 * @note 基于12方向采样检测边缘透明度，适用于卡通风格描边
 */
float isStroke(sampler2D _texture, vec2 _uv, float _outlineWidth) {
  // 预计算12个均匀分布方向的cos/sin值（对应30度间隔）
  float cosArray[12], sinArray[12]; 
  cosArray[0] = 1.0;   // 0度
  cosArray[1] = 0.866; // 30度
  cosArray[2] = .5;    // 60度
  cosArray[3] = 0.;    // 90度
  cosArray[4] = -.5;   // 120度
  cosArray[5] = -0.866;// 150度
  cosArray[6] = -.1;   // 180度（原值可能有误，应为-1.0）
  cosArray[7] = -0.866;// 210度
  cosArray[8] = -.5;   // 240度
  cosArray[9] = 0.;    // 270度
  cosArray[10] = .5;   // 300度
  cosArray[11] = 0.866;// 330度
  sinArray[0] = 0.;    // 0度
  sinArray[1] = 0.5;   // 30度
  sinArray[2] = 0.866; // 60度
  sinArray[3] = 1.;    // 90度
  sinArray[4] = 0.866; // 120度
  sinArray[5] = 0.5;   // 150度
  sinArray[6] = 0.;    // 180度
  sinArray[7] = -0.5;  // 210度
  sinArray[8] = -.866; // 240度
  sinArray[9] = -1.;   // 270度
  sinArray[10] = -.866;// 300度
  sinArray[11] = -0.5; // 330度
  
  float stroke = 0.;
  for(int i = 0; i < 12; i++){
    // 在12个方向进行采样检测
    float a = normalTexture(_texture, vec2(_uv.x + _outlineWidth * cosArray[i], _uv.y + _outlineWidth * sinArray[i])).a;
    if (a > 0.9) // 检测到不透明区域
    {
        stroke += 1.; // 累加有效采样点
    }
  }
  return stroke;
}

/**
 * 纹理流动效果
 * @param _texture 源纹理
 * @param _uv 当前纹理坐标
 * @param _speed 流动速度（建议0.1-2.0）
 * @param isVertical true=垂直流动 false=水平流动
 * @param isVerse true=反向流动
 * @return 处理后的颜色值
 * @example 
 * // 水平正向流动
 * vec4 color = flow(cc_spriteTexture, uv, 1.0, false, false);
 * // 垂直反向流动
 * vec4 color = flow(cc_spriteTexture, uv, 0.5, true, true);
 */
vec2 flow(vec2 _uv, float _speed, bool isHorizontal, bool isVertical, bool isVerse) {
  // 基于时间计算偏移量（使用ffract确保在0-1范围内）
  float offset = ffract(cc_time.x*_speed);
  if (isVerse) offset = 1. - offset; // 反向处理
  
  // 根据流动方向应用偏移
  vec2 uv = _uv + vec2(isHorizontal ? offset : 0., isVertical ? 1.-offset : 0.);
  uv -= step(1., uv); // 处理UV越界

  return uv;
}

/**
 * 纹理序列帧动画
 * @param _texture 包含所有帧的纹理图集
 * @param _uv 当前纹理坐标
 * @param _cells 行列数（如vec2(4,4)表示4x4网格）
 * @param _fps 帧率（每秒播放帧数）
 * @param _time 时间变量（通常传入cc_time）
 * @return 当前帧的颜色值
 * @example 
 * // 4x4图集，每秒播放5帧
 * vec4 anim = textureSwitch(cc_spriteTexture, uv, vec2(4,4), 5.0, cc_time);
 * @note 纹理需要按从左到右、从上到下排列动画帧
 */
vec4 textureSwitch(sampler2D _texture, vec2 _uv, vec2 _cells, float _fps, vec4 _time){
  // 计算当前帧索引
  float index = ffloor(_time.x * _fps); 
  
  // 解析行列数
  float col = _cells.x;
  float row = _cells.y;

  // 计算UV偏移量
  vec2 offset = vec2(
    mod(index,col)/col, // X轴偏移
    floor(mod(index, col*row)/col)/row // Y轴偏移
  );

  return texture(_texture, _uv / _cells.xy + offset);
}


//波纹
// amplitude: { value: 0.05, range: [0.0, 0.5], editor: { tooltip: '振幅' } }
//         angularVelocity: { value: 10.0, editor: { tooltip: '角速度' } }
//         frequency: { value: 10.0, editor: { tooltip: '频率' } }
//         offset: { value: 0.5, range: [0.0, 1.0], editor: { tooltip: '偏距' } }
//         toLeft: { value: false, editor: { type: boolean, tooltip: '向左（方向）' } }
vec4 wave(sampler2D _texture, vec2 _uv, float _amplitude,float _angularVelocity, float _frequency, float _offset, bool _toLeft){
  float y = _amplitude * sin((_angularVelocity * _uv.x) + ((_frequency * cc_time.x) * (_toLeft ? 1. : -1.))) + _offset;
  vec2 uv = _uv + vec2(0., y);
  uv.y -= 0.5;
  vec4 c = normalTexture(_texture, uv);
    //超出纹理范围的用透明填充
  if (uv.y < 0. || uv.y > 1.) c.a = 0.;
  return c;
}

/**
 * 图形波纹效果（仅保留波形上方的像素）
 * @param _o 原始颜色值（用于inout参数传递）
 * @param _uv 当前纹理坐标
 * @param _amplitude 波纹振幅（0.0-1.0）
 * @param _angularVelocity 角速度（控制波纹密度）
 * @param _frequency 频率（控制波动速度）
 * @param _offset 垂直偏移量（0.0-1.0）
 * @param _toLeft 波动方向（true向左，false向右）
 * @example
 * // 创建向左传播的波纹效果，振幅0.1，角速度5，频率2，垂直居中
 * graphicsWave(cc_fragColor, uv, 0.1, 5.0, 2.0, 0.5, true);
 */
void graphicsWave(vec4 _o, vec2 _uv, float _amplitude,float _angularVelocity, float _frequency, float _offset, bool _toLeft){
  // 根据时间、方向和参数计算波形Y值
  float y = _amplitude * sin((_angularVelocity * _uv.x) + ((_frequency * cc_time.x) * (_toLeft ? 1. : -1.))) + _offset;
  // 丢弃波形下方的像素（创建波纹裁剪效果）
  if (_uv.y < y) discard;
}

/**
 * 动态纹理平铺效果（带运动位移和棋盘格裁剪）
 * @param _uv 原始纹理坐标
 * @param _scale 平铺密度（值越大平铺次数越多）
 * @param _speed 平移动画速度（值越大移动越慢）
 * @param _offsetY Y轴偏移系数（控制每列垂直偏移量）
 * @return 处理后的纹理坐标
 * @example 
 * // 创建快速移动的棋盘格平铺效果
 * vec2 tiledUV = tiled(uv, 4.0, 10.0, 5.0);
 * vec4 color = texture(cc_spriteTexture, tiledUV);
 */
vec2 tiled(vec2 _uv, float _scale, float _speed, float _offsetY){
  // 应用缩放和时间位移
  vec2 uv = _uv * _scale - vec2(cc_time.x,cc_time.x) / _speed;
  // 计算列索引并生成棋盘格模式
  float b = ffloor(uv.x);
  uv.y -= b / _offsetY; // 每列添加垂直偏移
  // 丢弃奇数行列的像素创建棋盘格效果
  if (mod(b,2.) == 1. || mod(ffloor(uv.y),2.) == 1.) {discard;}
  // 取小数部分实现平铺重复
  uv = fract(uv);
  return uv;
}

/**
 * 动态缩放效果（以指定点为中心进行渐变缩放）
 * @param o 原始颜色值
 * @param _uv 当前纹理坐标
 * @param color 叠加颜色
 * @param point 缩放中心点（纹理空间坐标，0-1范围）
 * @param scaleMin 最小缩放系数
 * @param scaleMax 最大缩放系数
 * @return 处理后的颜色值
 * @example
 * // 创建从中心向外渐变的缩放效果，缩放范围0.5-2.0，叠加红色
 * vec4 finalColor = scale(cc_fragColor, uv, vec4(1,0,0,1), vec2(0.5,0.5), 0.5, 2.0);
 */
vec4 scale(vec4 o,vec2 _uv, vec4 color, vec2 point, float scaleMin, float scaleMax){
  vec2 uv = vec2(point.x,point.y);
  // 计算基于垂直坐标的渐变缩放系数
  float smin = scaleMin;
  float s = smin + (scaleMax - smin) * _uv.y;
  // 应用中心点相对缩放
  uv.x = uv.x - (uv.x - _uv.x)/s;
  uv.y = uv.y - (uv.y - _uv.y)/s;
  // 处理超出纹理范围的情况
  if(uv.x > 1.0 || uv.x < 0.0 || uv.y > 1.0 || uv.y < 0.0){
    o = vec4(0); // 透明填充
  }else{
    o *= CCSampleWithAlphaSeparated(cc_spriteTexture, uv); 
    // 处理纹理边缘透明区域
    if(o.a == 0.0) o = vec4(0);
  }
  o *= color; // 颜色叠加
  return o;
}

/**
 * 应用灰色遮罩效果（降低颜色亮度，保持透明度）
 * @param _o 原始颜色值
 * @return 处理后的颜色值（RGB各通道衰减50%，透明度不变）
 * @example
 * // 在片段着色器中应用灰色遮罩：
 * vec4 color = texture(cc_spriteTexture, uv);
 * gl_FragColor = maskColor(color); // 颜色会变暗50%
 */
vec4 maskColor(vec4 _o){
  vec4 maskcolor = vec4(.5, .5, .5, 1); // 中灰色遮罩（各通道乘0.5）
  _o*=maskcolor; // 颜色混合（保留原始alpha通道）
  return _o;
}

/**
 * 应用纯黑色遮罩（完全移除颜色信息，保持透明度）
 * @param _o 原始颜色值
 * @return 处理后的颜色值（RGB归零，透明度不变）
 * @example
 * // 创建全黑剪影效果：
 * vec4 color = texture(cc_spriteTexture, uv);
 * gl_FragColor = blackMaskColor(color); // 输出纯黑色（保留原始透明度）
 */
vec4 blackMaskColor(vec4 _o){
  vec4 maskcolor = vec4(0, 0, 0, 1); // 纯黑色遮罩
  _o*=maskcolor; // 颜色归零（保留原始alpha通道）
  return _o;
}

/**
 * 透明遮罩效果（移除颜色信息并降低透明度）
 * @param _o 原始颜色值
 * @return 处理后的颜色值（RGB归零，透明度降为50%）
 * @example
 * // 创建半透明黑色遮罩层：
 * vec4 color = texture(cc_spriteTexture, uv);
 * gl_FragColor = alphaMask(color); // 输出半透明黑色，适合作为UI遮罩
 * 
 * // 配合混合模式使用：
 * gl_FragColor = alphaMask(color) + otherColor; // 实现叠加混合效果
 */
vec4 alphaMask(vec4 _o){
  return vec4(0.0, 0.0, 0.0, _o.a * 0.5); // 颜色置黑，透明度减半
}