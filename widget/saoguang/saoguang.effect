CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        # 自定义参数
        # 宽度
        width: { value: 0.1 }
        # 强度
        strength: { value: 1.2 }
        # 手动扫光，dt
        aniTime: { value: 0 } 
        # 是否是自动扫光 1.0:自动
        auto: { value: 0 }
        # 方向 1.0:从左往右
        direction: { value: 0 }
        # 扫光角度
        angle: { value: 0 }
        # 自动扫光的速率
        speed: { value: 1.0}        
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 v_color;
  out vec2 v_uv0;

  #if USE_TEXTURE
    in vec2 a_uv0;
  #endif

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
      v_uv0 = a_uv0;
    #endif

    v_color = a_color;
    v_uv0 = a_texCoord;

    return pos;
  }
}%


CCProgram sprite-fs %{
  precision highp float;
  #include <embedded-alpha>
  #include <alpha-test>
  #include <cc-global>

  in vec4 v_color;

  #if USE_TEXTURE
    in vec2 v_uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 11) uniform sampler2D cc_spriteTexture;
  #endif

  uniform ARGS{
    float width;
    float strength;
    float aniTime;
    float auto;
    float direction;
    float speed;
    float angle;
  };

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);
    o *= CCSampleWithAlphaSeparated(cc_spriteTexture, v_uv0);
    if (o.a < 1.0) {
        discard;
    }
    float k = angle;
    float time_step = 0.0;

    if(direction == 1.0){
        time_step = - v_uv0.y * k;  // 从左边开始，保持斜向
        if(auto == 1.0){
            time_step += mod(cc_time.x * speed, 2.0 + width);
        }
        else if(auto == 0.0){
            time_step += mod(aniTime , 2.0 + width);
        }
    }
    else{
        time_step = 1.0 - v_uv0.y * k;  // 从右边开始，保持斜向
        if(auto == 1.0){
            time_step += 1.0 - mod(cc_time.x * speed, 2.0 + width);
        }
        else if(auto == 0.0){
            time_step += 1.0 - mod(aniTime, 2.0 + width);
        }
    }

    if (v_uv0.x >= time_step && v_uv0.x <= time_step + width) {
        float l = time_step;
        float c = time_step + width / 2.0;
        float r = time_step + width;
        float st = smoothstep(l, c, v_uv0.x) - smoothstep(c, r, v_uv0.x);
        st = st * strength + 1.0;
        o *= st;
        o.a = .8;
    }else{
      discard;
    }
    return o;
  }
}%